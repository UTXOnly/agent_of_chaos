# Copy to .env and adjust for docker compose: cp .env.example .env

AOCH_MODE=steady
AOCH_SERVICES=10
AOCH_LINES_PER_CYCLE=20
AOCH_LOG_DIR=/var/log/agent-of-chaos

# Examples for other modes (uncomment to use):
# AOCH_MODE=chaos
# AOCH_CHAOS_CRASH_RATE=3
# AOCH_MODE=pulse
# AOCH_PULSE_RAMP=300
# AOCH_PULSE_PEAK=120
# AOCH_PULSE_REST=600

# Benchmark suite (files are baked into the image at /app/benchmark_profiles.json):
# AOCH_BENCHMARK_CONFIG=/app/benchmark_profiles.json
# AOCH_BENCHMARK=profile-high-throughput

# Tag-filter fleet (docker-compose.tag-filter.yml)
DD_API_KEY=
# DD_SITE=datadoghq.com
# DD_HOSTNAME=aoc-tag-filter-lab
# AOC_VARIANT=baseline   # or: comparison (tags every log/metric with variant:...)
# DD_LOG_LEVEL=info
# AOCH_FLEET_MODE=steady
# AOCH_FLEET_SERVICES=4
# AOCH_FLEET_LINES_PER_CYCLE=20
# AOCH_FLEET_CYCLE_SLEEP_MS=250
