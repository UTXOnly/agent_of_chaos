# cp .env.example .env

DD_API_KEY=            # required: aoc.* metrics and events, and the agent's own metrics and profiles
# Notebooks are authored/published by the coding agent through Datadog MCP.
# Connect MCP separately; aoc does not use DD_APP_KEY. See docs/notebooks.md.
# DD_SITE=datadoghq.com
# DD_SUBDOMAIN=myorg   # so notebook links open https://myorg.datadoghq.com
# DD_APP_URL=https://myorg.datadoghq.com   # or the full browser URL (wins over DD_SITE/DD_SUBDOMAIN)

# A checkout of the agent's repository, for --b-src builds and the brief's
# code section (default ../datadog-agent; aoc.yaml's `source:` wins).
# DATADOG_AGENT_SRC=~/src/datadog-agent

# Agent settings for every run. Per-test settings go on the command line
# (aoc ab --env K=V, --b-env K=V) or in a profile's agent.env.
# DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL=true
# DD_LOG_LEVEL=info
# DD_INTERNAL_PROFILING_PERIOD=60s   # one agent profile per period; 30s for very short runs
