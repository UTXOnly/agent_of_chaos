# Copy to .env and adjust: cp .env.example .env

# ── Datadog: where every run is recorded ─────────────────────────────────────
DD_API_KEY=                               # required: aoc.* metrics + events, and the agent's own metrics/profiles
DD_APP_KEY=                               # optional: lets `aoc notebook` / `aoc run --notebook` create notebooks
# DD_SITE=datadoghq.com

# ── harness (docker-compose.yml) ─────────────────────────────────────────────
# DD_AGENT_IMAGE=datadog/agent:7          # agent under test (any image/tag)
# AOC_RUN_NAME=local                       # run:<name> tag on every metric/event (aoc run sets it per run)
# AOC_DD_TAGS=harness:aoc                  # extra tags on the intake's aoc.* metrics
# AOC_STREAMS=8                            # per generator
# AOC_RATE=2000                            # lines/s per generator (0 = flat out)
# AOC_ROTATE_BYTES=2MiB
# AOC_ROTATE_MODE=rename                   # or truncate (copytruncate-style)
# AOC_MULTILINE_RATE=0.05
# AOC_WIDE_LINE_RATE=0
# AOC_SCENARIO=                            # wave | business-day | incident | longhaul (with AOC_MODE=scenario)
# DD_LOGS_CONFIG_AUTO_MULTI_LINE_DETECTION=false
# DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL=true
# DD_LOG_LEVEL=info

# DD_INTERNAL_PROFILING_ENABLED=true      # agent CPU/heap profiles in the Continuous Profiler
# No Datadog account? add -f docker-compose.offline.yml (any DD_API_KEY value works then)

# ── tag-filter fleet (docker-compose.tag-filter.yml) ─────────────────────────
# DD_HOSTNAME=aoc-tag-filter-lab
# AOC_VARIANT=baseline                     # or comparison — the run:/variant: tag and the report name
# DD_AGENT_IMAGE=datadog/agent-dev:log-tag-filtering-9e35a50b-full
# AOC_FLEET_STREAMS=4
# AOC_FLEET_RATE=300                       # lines/s per generator container (15 containers)
# AOC_FLEET_ROTATE_BYTES=512KiB
# AOC_FLEET_MULTILINE_RATE=0.05
